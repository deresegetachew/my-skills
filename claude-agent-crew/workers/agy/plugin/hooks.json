{
  "claude-agent-crew-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$HOME/.bun/bin:$PATH\" bun ./scripts/guard.ts",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
