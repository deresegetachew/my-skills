{
  "_about": "my-skills builds itself with its own factory (#112). Only what differs from the defaults is set here; `factory settings` shows the rest. Tests: bun tools/run_tests.ts (also CI). protected: pull requests that touch these paths are merged by the dev manager or the owner. The kit's own files (agents, skills, hooks that guard, CI, the release) are listed one by one so ordinary factory changes can still merge themselves.",
  "agents": [
    "menelik",
    "taytu",
    "haile"
  ],
  "tasks": {
    "source": "issues",
    "staleHours": 3
  },
  "mainBranch": "main",
  "prd": "software-factory/docs/PRD.md",
  "trustedReviewers": [
    "deresegetachew"
  ],
  "permissions": {
    "allow": [
      "Bash(bun tools/run_tests.ts*)",
      "Bash(bun tools/check_skills.ts*)",
      "Bash(bun x tsc*)",
      "Bash(./factory run-check*)"
    ]
  },
  "commands": {
    "lint": "bun tools/check_skills.ts",
    "test": "bun tools/run_tests.ts"
  },
  "codePaths": [
    "software-factory",
    "nestjs-best-practices",
    "nestjs-clean-code-ddd-hexagonal",
    "study-notes",
    "tools"
  ],
  "alwaysAllowed": [],
  "protected": [
    "^CLAUDE\\.md$",
    "^\\.claude/",
    "^\\.github/",
    "^\\.mcp\\.json$",
    "^factory$",
    "^factory-loop\\.sh$",
    "^software-factory/(factory|factory-loop\\.sh)$",
    "^install\\.sh$",
    "^tools/build_release\\.ts$",
    "^software-factory/VERSION$",
    "^software-factory/hooks/(pr-gate|factory_guard|manager_gate|factory_config|factory_release|check|factory_stop|factory_session|factory_agent_settings)\\.ts$",
    "^software-factory/kit/\\.claude/(settings\\.json|factory/settings\\.json|manager/|product-owner/|agents/|skills/)",
    "^software-factory/kit/\\.github/",
    "^software-factory/ci/(ci\\.sh|entrypoint\\.sh|loop\\.sh)$",
    "\\.env"
  ],
  "testPaths": [
    "(^|/)tests/",
    "(^|/)test_[^/]*\\.py$"
  ],
  "dependencyManifests": [
    "(^|/)(package\\.json|requirements[^/]*\\.txt|pyproject\\.toml)$"
  ],
  "reviews": {
    "safety-auditor": {
      "paths": [
        "^software-factory/hooks/(pr-gate|factory_guard|manager_gate|factory_release)\\.ts$",
        "^software-factory/kit/\\.claude/settings\\.json$",
        "^tools/build_release\\.ts$"
      ]
    },
    "security-reviewer": {
      "paths": [
        "^software-factory/hooks/(factory_netguard|factory_sandbox|factory_bootstrap[^/]*|factory_release)\\.ts$",
        "^software-factory/ci/",
        "^\\.github/workflows/"
      ]
    }
  },
  "waitMinutes": 5
}
