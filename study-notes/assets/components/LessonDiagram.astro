---
interface Props {
  /**
   * Mermaid diagram definition. Use standard classDefs for colours:
   *   :::step      — blue  (action/process nodes)
   *   :::decision  — purple (branch/routing nodes)
   *   :::done      — green  (success/terminal nodes)
   *   :::warn      — red    (error/warning nodes)
   *
   * Add these at the bottom of your definition:
   *   classDef step     fill:#dbeafe,color:#1e3a8a,stroke:#2563eb,stroke-width:2px
   *   classDef decision fill:#ede9fe,color:#4c1d95,stroke:#7c3aed,stroke-width:2px
   *   classDef done     fill:#dcfce7,color:#14532d,stroke:#16a34a,stroke-width:2px
   *   classDef warn     fill:#fee2e2,color:#7f1d1d,stroke:#dc2626,stroke-width:2px
   *
   * Every diagram gets a zoom viewer: the ⤢ button (or clicking the diagram)
   * opens it full screen with wheel/pinch zoom, drag to pan, Fit, and Esc.
   */
  definition: string;
}
const { definition } = Astro.props;
---
<figure class="lesson-diagram">
  <button class="ld-zoom-btn" type="button" title="Open full screen (zoom & pan)" aria-label="Open diagram full screen">⤢</button>
  <!--
    set:text prevents HTML escaping issues with mermaid syntax characters.
    Mermaid reads textContent, so entities like &lt; would break parsing.
  -->
  <pre class="mermaid" set:text={definition.trim()} />
</figure>

<script>
  // One shared viewer for every diagram on the page, created on first use.
  let viewer: HTMLDialogElement | null = null;
  let scale = 1, x = 0, y = 0;

  function apply() {
    const stage = viewer!.querySelector<HTMLElement>('.ld-stage')!;
    stage.style.transform = `translate(${x}px, ${y}px) scale(${scale})`;
    viewer!.querySelector('.ld-pct')!.textContent = `${Math.round(scale * 100)}%`;
  }

  function fit() {
    const canvas = viewer!.querySelector<HTMLElement>('.ld-canvas')!;
    const svg = viewer!.querySelector<SVGSVGElement>('.ld-stage svg');
    if (!svg) return;
    const vb = svg.viewBox.baseVal;
    const w = vb && vb.width ? vb.width : svg.getBoundingClientRect().width / scale;
    const h = vb && vb.height ? vb.height : svg.getBoundingClientRect().height / scale;
    const pad = 32;
    scale = Math.min((canvas.clientWidth - pad) / w, (canvas.clientHeight - pad) / h);
    x = (canvas.clientWidth - w * scale) / 2;
    y = (canvas.clientHeight - h * scale) / 2;
    apply();
  }

  function zoomAt(factor: number, cx: number, cy: number) {
    const next = Math.min(8, Math.max(0.2, scale * factor));
    x = cx - (cx - x) * (next / scale);
    y = cy - (cy - y) * (next / scale);
    scale = next;
    apply();
  }

  function buildViewer() {
    const d = document.createElement('dialog');
    d.className = 'ld-viewer';
    d.innerHTML = `
      <div class="ld-toolbar">
        <button type="button" data-act="out" aria-label="Zoom out">−</button>
        <span class="ld-pct">100%</span>
        <button type="button" data-act="in" aria-label="Zoom in">+</button>
        <button type="button" data-act="fit">Fit</button>
        <span class="ld-hint">scroll to zoom · drag to pan · double-click to fit</span>
        <button type="button" data-act="close" class="ld-close" aria-label="Close">✕</button>
      </div>
      <div class="ld-canvas"><div class="ld-stage"></div></div>`;
    document.body.appendChild(d);

    const canvas = d.querySelector<HTMLElement>('.ld-canvas')!;
    d.querySelector('.ld-toolbar')!.addEventListener('click', (e) => {
      const act = (e.target as HTMLElement).closest('button')?.dataset.act;
      const cx = canvas.clientWidth / 2, cy = canvas.clientHeight / 2;
      if (act === 'in') zoomAt(1.25, cx, cy);
      if (act === 'out') zoomAt(0.8, cx, cy);
      if (act === 'fit') fit();
      if (act === 'close') d.close();
    });
    canvas.addEventListener('wheel', (e) => {
      e.preventDefault();
      const r = canvas.getBoundingClientRect();
      zoomAt(Math.exp(-e.deltaY * 0.0015), e.clientX - r.left, e.clientY - r.top);
    }, { passive: false });

    // Drag to pan (mouse, pen, one finger); two fingers pinch-zoom.
    const pts = new Map<number, { x: number; y: number }>();
    let pinchDist = 0;
    canvas.addEventListener('pointerdown', (e) => { canvas.setPointerCapture(e.pointerId); pts.set(e.pointerId, { x: e.clientX, y: e.clientY }); });
    canvas.addEventListener('pointermove', (e) => {
      const prev = pts.get(e.pointerId);
      if (!prev) return;
      pts.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (pts.size === 1) { x += e.clientX - prev.x; y += e.clientY - prev.y; apply(); return; }
      const [a, b] = [...pts.values()];
      const dist = Math.hypot(a.x - b.x, a.y - b.y);
      if (pinchDist) {
        const r = canvas.getBoundingClientRect();
        zoomAt(dist / pinchDist, (a.x + b.x) / 2 - r.left, (a.y + b.y) / 2 - r.top);
      }
      pinchDist = dist;
    });
    const end = (e: PointerEvent) => { pts.delete(e.pointerId); if (pts.size < 2) pinchDist = 0; };
    canvas.addEventListener('pointerup', end);
    canvas.addEventListener('pointercancel', end);
    canvas.addEventListener('dblclick', fit);
    d.addEventListener('click', (e) => { if (e.target === d) d.close(); });   // click on the backdrop
    return d;
  }

  function open(figure: HTMLElement) {
    const svg = figure.querySelector('pre svg, .mermaid svg');
    if (!svg) return;                                   // not rendered yet
    viewer ??= buildViewer();
    const clone = svg.cloneNode(true) as SVGSVGElement;
    const vb = (svg as SVGSVGElement).viewBox.baseVal;
    clone.removeAttribute('style');                     // drop mermaid's max-width
    if (vb && vb.width) { clone.setAttribute('width', String(vb.width)); clone.setAttribute('height', String(vb.height)); }
    viewer.querySelector('.ld-stage')!.replaceChildren(clone);
    viewer.showModal();
    requestAnimationFrame(fit);
  }

  document.querySelectorAll<HTMLElement>('.lesson-diagram').forEach((figure) => {
    figure.querySelector('.ld-zoom-btn')?.addEventListener('click', (e) => { e.stopPropagation(); open(figure); });
    figure.addEventListener('click', () => open(figure));
  });
</script>

<style is:global>
  .lesson-diagram { position: relative; cursor: zoom-in; }
  .ld-zoom-btn {
    position: absolute; top: .5rem; right: .5rem; z-index: 1;
    width: 1.9rem; height: 1.9rem; border-radius: 6px; cursor: pointer;
    border: 1px solid var(--border); background: var(--bg); color: var(--muted);
    font-size: 1rem; line-height: 1; opacity: .7; transition: opacity .15s, border-color .15s;
  }
  .ld-zoom-btn:hover { opacity: 1; border-color: var(--accent); color: var(--accent); }

  .ld-viewer {
    width: 96vw; height: 92vh; max-width: none; max-height: none; padding: 0;
    border: 1px solid var(--border); border-radius: 10px;
    background: var(--bg); color: var(--ink); overflow: hidden;
  }
  .ld-viewer[open] { display: flex; flex-direction: column; }
  .ld-viewer::backdrop { background: rgba(0, 0, 0, .55); }
  .ld-toolbar {
    display: flex; align-items: center; gap: .4rem; padding: .5rem .75rem;
    border-bottom: 1px solid var(--border); background: var(--bg2); font-size: .8rem;
  }
  .ld-toolbar button {
    min-width: 2rem; height: 1.9rem; padding: 0 .6rem; border-radius: 6px; cursor: pointer;
    border: 1px solid var(--border); background: var(--bg); color: var(--ink); font-size: .85rem;
  }
  .ld-toolbar button:hover { border-color: var(--accent); }
  .ld-pct { min-width: 3.2rem; text-align: center; font-family: monospace; color: var(--muted); }
  .ld-hint { color: var(--muted); margin-left: .5rem; }
  .ld-close { margin-left: auto; }
  .ld-canvas { position: relative; flex: 1; overflow: hidden; cursor: grab; touch-action: none; background: var(--bg2); }
  .ld-canvas:active { cursor: grabbing; }
  .ld-stage { position: absolute; top: 0; left: 0; transform-origin: 0 0; }
  .ld-stage svg { display: block; max-width: none !important; }
  @media (max-width: 640px) { .ld-hint { display: none; } }
</style>
