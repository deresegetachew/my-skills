---
import LessonNav   from '@/components/LessonNav.astro';
import AiTutor     from '@/components/AiTutor.astro';
import ThemeHead   from '@/components/ThemeHead.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import { LESSONS } from '@/data/lessons';

interface Props { title: string; }
const { title } = Astro.props;

const current = Astro.url.pathname.replace(/\/$/, '');
const idx  = LESSONS.findIndex(l => l.href === current);
const prev = idx > 0                  ? LESSONS[idx - 1] : undefined;
const next = idx < LESSONS.length - 1 ? LESSONS[idx + 1] : undefined;
const hasNav = prev || next;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <ThemeHead />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap" />
</head>
<body>
  <div class="rocket-mascot" aria-hidden="true" title="Rocket — your AI study buddy">🦝</div>
  <article class="lesson-article">
    {hasNav && (
      <LessonNav prevHref={prev?.href} prevTitle={prev?.title} nextHref={next?.href} nextTitle={next?.title} top />
    )}
    <slot />
    {hasNav && (
      <LessonNav prevHref={prev?.href} prevTitle={prev?.title} nextHref={next?.href} nextTitle={next?.title} />
    )}
  </article>

  <ThemeToggle />
  <script is:inline src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
  <AiTutor />

  <script is:inline src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js"></script>
  <script is:inline>
    mermaid.initialize({
      startOnLoad: false,
      theme: 'base',
      flowchart: { curve: 'basis', htmlLabels: true },
      themeVariables: {
        primaryColor:        '#dbeafe',
        primaryTextColor:    '#1e3a8a',
        primaryBorderColor:  '#2563eb',
        lineColor:           '#6b7280',
        secondaryColor:      '#ede9fe',
        secondaryTextColor:  '#4c1d95',
        secondaryBorderColor:'#7c3aed',
        tertiaryColor:       '#dcfce7',
        tertiaryTextColor:   '#14532d',
        tertiaryBorderColor: '#16a34a',
        background:          '#f8fafc',
        edgeLabelBackground: '#ffffff',
        fontFamily:          '"JetBrains Mono", monospace',
        fontSize:            '13px',
      }
    });
    document.addEventListener('DOMContentLoaded', () => {
      mermaid.run({ querySelector: '.mermaid' });
    });
  </script>

  <!-- markmap autoloader — no-op on pages without .markmap elements -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/markmap-autoloader@0.17"></script>

</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
