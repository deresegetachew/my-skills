}

cmd="${1:-help}"; shift || true
case "$cmd" in
  loop)
    # A role word (or FACTORY_ROLE) picks the role. `factory loop -i` alone, in a terminal, asks which (#102); an
    # unattended `factory loop` (no -i, scripts, autostart) stays a coding agent, so nothing running today changes.
    rest=(); want="${FACTORY_ROLE:-}"; asks=0
    for a in "$@"; do
      case "$a" in coding-agent|dev-manager|product-owner) want="$a" ;; -i|--interactive) asks=1; rest+=("$a") ;; *) rest+=("$a") ;; esac
    done
    if [ -z "$want" ] && [ "$asks" = 1 ] && [ -t 0 ] && [ -t 2 ]; then
      pick="$(fh "$hooks/factory_roles" choose)" || exit 1
      read -r want pickname <<< "$pick"
      to_window "$want" "$pickname" ${rest[@]+"${rest[@]}"}
      exec env FACTORY_ROLE="$want" FACTORY_NAME="$pickname" "$root/factory-loop.sh" ${rest[@]+"${rest[@]}"}
    fi
    [ -n "$want" ] && export FACTORY_ROLE="$want"
    to_window "${want:-coding-agent}" "${FACTORY_NAME:-}" ${rest[@]+"${rest[@]}"}
    exec "$root/factory-loop.sh" ${rest[@]+"${rest[@]}"} ;;
  coding-agent|dev-manager|product-owner)
    role="$cmd"; who=""
    if [ -n "${1:-}" ] && [ "$1" != loop ]; then who="$1"; shift; fi
    [ "${1:-}" = loop ] || { echo "usage: factory $role [name|N] loop [-i] [--once] [--dry-run]" >&2; exit 1; }
    shift
    case "$who" in ''|*[!0-9]*) ;; *) who="$(fh "$hooks/factory_roles" nth "$role" "$who")" || exit 1 ;; esac
    to_window "$role" "$who" "$@"
    exec env FACTORY_ROLE="$role" FACTORY_NAME="$who" "$root/factory-loop.sh" "$@" ;;
  init)      fh "$hooks/factory_init" "$@" ;;
  init-roles) fh "$hooks/factory_roles" init "$@" ;;
  agent)
    # --detach (#106): start the agent in a detached tmux session, which `factory follow <name>` finds from anywhere.
    detach=0; rest=()
    for a in "$@"; do if [ "$a" = --detach ]; then detach=1; else rest+=("$a"); fi; done
    set -- ${rest[@]+"${rest[@]}"}
    if [ "$detach" = 1 ]; then fh "$hooks/factory_follow" detach "$@"; exit $?; fi
    [ -n "${1:-}" ] || { echo "usage: factory agent <name|N> [claude arguments]: Claude in that agent's folder, for manual work. To run the queue, use factory loop -i (a fresh session per task)." >&2; exit 1; }
    who="$1"; shift
    bare=0; [ "$#" = 0 ] && bare=1
    dir="$(fh "$hooks/factory_claims" worktree "$who")" || exit 1
    name="$(basename "$dir")"; [ "$dir" = "$root" ] && name="$who"
    echo "$name: $dir"
    # One session for many tasks grows with each one (#56): the loop gives every task a fresh context instead.
    [ "$bare" = 1 ] && echo "For manual work in $name's folder. To run the queue, use factory loop -i instead: a fresh session per task."
    cd "$dir" || exit 1
    # A reused worktree may be behind main's submodule pin, and a new one may have none yet: without it the kit's
    # links in .claude/ point at nothing and Claude would start without the hooks and deny rules (#46).
    if [ -f .gitmodules ]; then git submodule update --init -q || { echo "factory: git submodule update failed in $dir" >&2; exit 1; }; fi
    # The agents' rules (#258), or a not-yet-updated project's old .claude/settings.json, and the hook that reads them.
    if { [ ! -e .claude/factory/settings.json ] && [ ! -e .claude/settings.json ]; } || [ ! -e .claude/hooks/factory_agent_settings.ts ]; then
      echo "factory: $dir/.claude/factory/settings.json doesn't resolve, so the factory's hooks and deny rules wouldn't load. Run \`git submodule update --init\` there, or \`bash vendor/my-skills/software-factory/install.sh . --link\`, and try again." >&2
      exit 1
    fi
    # Only the project's MCP servers, as main has them on origin (never this worktree's .mcp.json), and never the
    # user's own connectors (#55), as in factory-loop.sh. --mcp-config takes several values, so a flag must follow it.
    mcp="$(fh "$dir/.claude/hooks/factory_mcp")"; [ -n "$mcp" ] || mcp='{"mcpServers":{}}'
    # The agents' rules as main has them on origin (#258), as in factory-loop.sh. No rules, no session.
    agent_settings="$(fh "$dir/.claude/hooks/factory_agent_settings")" || exit 1
    # The `models` setting for the builder (factory_models.ts): after the MCP flags, before your own arguments.
    mf=()
    if [ -f "$dir/.claude/hooks/factory_models.ts" ]; then
      m="$(fh "$dir/.claude/hooks/factory_models" flags builder 2>&1)" || { echo "$m" >&2; exit 1; }
      while IFS= read -r line; do [ -n "$line" ] && mf+=("$line"); done <<< "$m"
    fi
    set -- --mcp-config "$mcp" --strict-mcp-config --settings "$agent_settings" ${mf[@]+"${mf[@]}"} "$@"
    # Remote Control, as in `factory loop -i`: reach this session from claude.ai/code or your phone.
    # FACTORY_REMOTE_CONTROL=0|1 wins; else this machine's `remoteControl` setting (factory settings --local); else on.
    rc="${FACTORY_REMOTE_CONTROL:-}"; [ -n "$rc" ] || rc="$(fh "$dir/.claude/hooks/factory_machine" remote 2>/dev/null || echo 1)"
    if [ "$rc" = 1 ]; then exec claude --remote-control="$name" "$@"; fi
    exec claude "$@" ;;
  worktree)  fh "$hooks/factory_claims" worktree "${1:?usage: factory worktree <name|N>}" ;;
  issues)    fh "$hooks/factory_issues" "${1:-list}" "${@:2}" ;;
  machine)   fh "$hooks/factory_machine" "${1:-show}" "${@:2}" ;;
  follow|say|remote)  fh "$hooks/factory_follow" "$cmd" "$@" ;;
  agents)    fh "$hooks/factory_agents" "${1:-list}" "${@:2}" ;;
  messages)  fh "$hooks/factory_messages" "${1:-ls}" "${@:2}" ;;
  alerts)    fh "$hooks/factory_alerts" "${1:-check}" "${@:2}" ;;
  heartbeat) fh "$hooks/factory_heartbeat" "${1:-status}" "${@:2}" ;;
  next)      fh "$hooks/next_task" --note "$@" ;;
  autostart) fh "$hooks/factory_autostart" "$@" ;;
  resume)    fh "$hooks/factory_resume" "$@" ;;
  status)    fh "$hooks/factory_status" "$@" ;;
  cockpit)   FACTORY_SELF="$here" fh "$hooks/factory_cockpit" "$@" ;;
  prs)       fh "$hooks/factory_prs" "$@" ;;
  owner)     fh "$hooks/factory_owner" "$@" ;;
  claims)    fh "$hooks/factory_claims" "${1:-list}" "${@:2}" ;;
  release)   fh "$hooks/factory_claims" release --agent "${1:?usage: factory release <agent>}" ;;
  clean)     fh "$hooks/factory_claims" clean ;;
  reviews)   fh "$hooks/factory_reviews" "$@" ;;
  rereview)  fh "$hooks/factory_rereview" "$@" ;;
  review-pass) fh "$hooks/factory_review_pass" "$@" ;;
  reset-run)   fh "$hooks/factory_reset_run" "$@" ;;
  manager-claims) fh "$hooks/factory_manager_claims" "$@" ;;
  lessons)   fh "$hooks/factory_lessons" "${1:-show}" "${@:2}" ;;
  settings)  fh "$hooks/factory_settings" "$@" ;;
  usage)     fh "$hooks/factory_usage" "$@" ;;
  report)    fh "$hooks/factory_report" "$@" ;;
  env)       if [ -n "${1:-}" ]; then
               case "$1" in *[!0-9]*) a="$1";; *) a="agent-$1";; esac; fh "$hooks/factory_env" --agent "$a"
             else fh "$hooks/factory_env"; fi ;;
  verify)    fh "$hooks/factory_verify" "$@" ;;
  fix)       fh "$hooks/factory_fix" "$@" ;;
  run-check) fh "$hooks/factory_run_check" "$@" ;;
  check)     fh "$hooks/style_checks" ;;
  guard)     fh "$hooks/factory_guard" --base "origin/$(main)" --branch "$(git branch --show-current)" "$@" ;;
  doctor)    fh "$hooks/factory_doctor" "$@" ;;
  wait)      case "${1:-}" in
               ci|answer|slot|ready) fh "$hooks/factory_wait" "$@" ;;
               *) exec "$hooks/wait_for_merge.sh" "${1:?usage: factory wait <pr> [minutes] | ci|answer <pr> | slot | ready}" "${2:-30}" ;;
             esac ;;
  precheck)  fh "$hooks/factory_wait" precheck ;;
  watch)     fh "$hooks/factory_watch" "$@" ;;
  prd)       fh "$hooks/factory_prd" "$@" ;;
  artifacts) fh "$hooks/factory_artifacts" "$@" ;;
  handover)  fh "$hooks/factory_handover" "$@" ;;
  signoff)   fh "$hooks/factory_signoff" "$@" ;;
  manage-tick) fh "$hooks/factory_tick" "$@" ;;
  turbo)     fh "$hooks/factory_turbo" "$@" ;;
  version|releases|rollback|migrate-to-release) fh "$hooks/factory_release" "$cmd" "$@" ;;
  update)
    # Never inside the factory's own repo (my-skills): the releases come from there (#162).
    fh "$hooks/factory_release" check-own-repo || exit 1
    # A project with a release pin (.claude/factory/release.json), or one that asks (a version, --release), takes the
    # factory from numbered releases (#113). Any other project keeps the submodule update below until it migrates.
    if [ -f .claude/factory/release.json ]; then fh "$hooks/factory_release" update "$@"; exit $?; fi
    for a in "$@"; do case "$a" in --release|--archive|--archive=*|v[0-9]*|[0-9]*) fh "$hooks/factory_release" update "$@"; exit $? ;; esac; done
    # `--layout new` (or `auto`) is still accepted and changes nothing: there is one layout since the kit/ forwarders went
    # (#176); `old` is refused.
    layout=new
    case "${1:-}" in
      --layout) layout="${2:-}" ;;
      --layout=*) layout="${1#--layout=}" ;;
      "") ;;
      *) echo "factory: unknown option $1 (factory update [--layout new])" >&2; exit 1 ;;
    esac
    case "$layout" in new|auto) ;; *) printf '{"code": "layout_removed", "message": "--layout %s is gone: the kit/ forwarders it linked through were removed (#176).", "fix": "run factory update without --layout; links into kit/ are relinked to the new folders."}\n' "$layout" >&2; exit 1 ;; esac
    sub="$(git config -f .gitmodules --get-regexp 'submodule\..*\.url' | awk '/my-skills/ {split($1, a, "."); print a[2]}' | head -1)"
    [ -n "$sub" ] || { echo "factory: no my-skills submodule in .gitmodules" >&2; exit 1; }
    path="$(git config -f .gitmodules --get "submodule.$sub.path")"
    old="$(git -C "$path" rev-parse --short HEAD 2>/dev/null || echo none)"
    git submodule update --init -q "$path" && git submodule update --remote -q "$path" || exit 1
    new="$(git -C "$path" rev-parse --short HEAD)"
    # Same commit: still relink, so links a project made through kit/ before #176 are moved (a re-run changes nothing).
    if [ "$old" = "$new" ]; then echo "my-skills is already at $new"
    else echo "my-skills $old -> $new:"; git -C "$path" log --oneline "$old..$new" 2>/dev/null | sed 's/^/  /'; fi
    bash "$path/software-factory/install.sh" . --link | grep -E '^(relinked|linked .*was a copy|kept .*differs)' || true
    echo; echo "Now commit it on a branch and open a PR, for example:"
    echo "  git checkout -b chore/update-my-skills && git add -A && git commit -m \"Update my-skills to $new\"" ;;
  install-shim)
    bin="${HOME}/.local/bin"; mkdir -p "$bin"
    cat > "$bin/factory" <<'EOF'
#!/usr/bin/env bash
# Runs the `factory` of the project you're in, so each project uses the factory version it pins.
root="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "factory: run this inside a project's git repo" >&2; exit 1; }
[ -x "$root/factory" ] && exec "$root/factory" "$@"
echo "factory: $root has no ./factory. Install the software factory there first." >&2; exit 1
EOF
    chmod +x "$bin/factory"
    echo "Installed $bin/factory."
    case ":$PATH:" in *":$bin:"*) ;; *) echo "Add it to your PATH, for example in ~/.zshrc:  export PATH=\"\$HOME/.local/bin:\$PATH\"";; esac ;;
  ci)        case "${1:-}" in
               log)     fh "$hooks/factory_ci_log" "${@:2}" ;;
               runners) fh "$hooks/factory_ci_runners" "${@:2}" ;;
               clean)   fh "$hooks/factory_ci_clean" "${@:2}" ;;
               *)       exec bash "$root/.claude/ci/ci.sh" "$@" ;;
             esac ;;
  help|-h|--help) usage ;;
  *) echo "factory: unknown command '$cmd'" >&2; usage >&2; exit 1 ;;
esac
