#!/usr/bin/env bash
# The software factory's command line. Run it from anywhere inside the project (or one of its agent worktrees):
#   ./factory <command>        or, with the shim on your PATH (factory install-shim), just: factory <command>
[ -n "${BASH_VERSION:-}" ] || exec bash "$0" "$@"
set -uo pipefail
# Run a factory script (<path>.ts) with Bun. --no-env-file: Bun must not load the project's .env into the factory.
fh() {
  local s="$1"; shift
  command -v bun >/dev/null 2>&1 || { printf '{"code": "bun_missing", "message": "%s needs Bun, and bun is not on the PATH.", "fix": "Install Bun (curl -fsSL https://bun.sh/install | bash), open a new terminal, then run the command again."}\n' "${s##*/}.ts" >&2; return 127; }
  bun --no-env-file --config=/dev/null "$s.ts" "$@"
}
# `factory bootstrap` sets up a machine, so it works before there is a checkout: it runs from where this script lives.
if [ "${1:-}" = bootstrap ]; then
  self="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
  fh "$(dirname "$self")/hooks/factory_bootstrap" "${@:2}"; exit $?
fi
# This script's own path, before the cd: the cockpit's panes and popups run the factory through it (#308).
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
root="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "factory: run this inside the project's git repo" >&2; exit 1; }
cd "$root"
hooks="$root/.claude/hooks"
# One value of .claude/factory.json (`setting mainBranch main`, `setting commands.install ""`): the default when the key
# is missing; fails when the file is missing or not JSON.
setting() {
  bun --no-env-file --config=/dev/null -e 'const [k, d] = process.argv.slice(1); let v = JSON.parse(require("node:fs").readFileSync(".claude/factory.json", "utf8"));
for (const p of k.split(".")) v = v !== null && typeof v === "object" && !Array.isArray(v) && p in v ? v[p] : undefined;
console.log(v === undefined ? d : typeof v === "string" ? v : JSON.stringify(v));' "$@"
}
main() { setting mainBranch main; }
# `loop -i` on a terminal starts in its own tmux window (#300), through the one step `factory resume` uses too, and
# shows it here. Inside that window (FACTORY_WINDOW), without a terminal (scripts, tests) or with --dry-run it runs
# in place. Without tmux it runs in place too, with a note: only the cockpit needs tmux (#295).
# Usage: to_window <role> <name or ""> <loop arguments>; it returns only when the loop runs here.
to_window() {
  local r="$1" n="$2" a i=0; shift 2
  for a in "$@"; do case "$a" in -i|--interactive) i=1 ;; --dry-run) return 0 ;; esac; done
  [ "$i" = 1 ] && [ -z "${FACTORY_WINDOW:-}" ] && [ -t 0 ] && [ -t 1 ] || return 0
  command -v tmux >/dev/null 2>&1 || {
    echo "Note: tmux is not installed, so the loop runs here. With tmux it would run in its own tmux window."
    return 0
  }
  fh "$hooks/factory_window" loop --role "$r" ${n:+--name "$n"} -- "$@"; exit $?
}

usage() {
  cat <<'EOF'
factory <command>

