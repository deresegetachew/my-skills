#!/usr/bin/env bash
# The software factory's command line. Run it from anywhere inside the project (or one of its agent worktrees):
#   ./factory <command>        or, with the shim on your PATH (factory install-shim), just: factory <command>
[ -n "${BASH_VERSION:-}" ] || exec bash "$0" "$@"
set -uo pipefail
# `factory bootstrap` sets up a machine, so it works before there is a checkout: it runs from where this script lives.
if [ "${1:-}" = bootstrap ]; then
  self="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
  exec python3 "$(dirname "$self")/hooks/factory_bootstrap.py" "${@:2}"
fi
root="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "factory: run this inside the project's git repo" >&2; exit 1; }
cd "$root"
hooks="$root/.claude/hooks"
py() { python3 "$hooks/$1" "${@:2}"; }
main() { python3 -c 'import json;print(json.load(open(".claude/factory.json")).get("mainBranch","main"))'; }

usage() {
  cat <<'EOF'
factory <command>

Build
  loop [-i] [N]          start a coding agent loop: one fresh Claude run per task (-i: a session you can type into,
                         which closes by itself when the task is done). Start it again in another terminal for more agents.
                         FACTORY_AGENTS=haile,tewodros (or factory machine setup): only those names on this machine.
                         `loop -i` in a terminal asks which role and name; `loop -i dev-manager` or FACTORY_ROLE skips it
  coding-agent [name|N] loop [-i] [--once] [--dry-run] [N]
  dev-manager  [name|N] loop [-i] [--once] [--dry-run]
  product-owner [name|N] loop [-i] [--once] [--dry-run]
                         the roles, started the same way and run by the same loop (#102). The dev manager is an
                         orchestrator with no model: it watches GitHub and starts one-item sub-managers (#97). Names come
                         from roles.<role>.names; --once runs one pass, --dry-run prints what a pass would do
  init [--dry-run]       the project's scaffold: role folders, labels, the owner queue, a starter PRD and the PRD-change
                         PR template; says what it made, adds nothing twice (then the next steps to a first milestone)
  init-roles [--force]   create the project's role folders (.claude/factory/roles/<role>/README.md and reads.md)
  agent <name|N>         open Claude in that agent's own worktree (created the first time), for manual work there.
                         To run the queue, use loop -i instead (a fresh session per task). --detach: in a detached
                         tmux session instead, which `factory follow <name>` finds from another machine
                         Agents are named in factory.json (menelik, taytu, haile ...); 2 means the second name
  next                   the job the factory would hand out next
  autostart [status|install|uninstall]
                         bring this machine back after a reboot: the dev stack (commands.stackUp) and its agents, in
                         detached tmux sessions, with unfinished work saved and left in place. status shows what would
                         start; install --agents haile,tewodros turns it on (systemd user unit with linger, or a LaunchAgent)
  resume [--dry-run]     what autostart runs at boot: stack, then agents; safe to run by hand (running agents are left alone)
  heartbeat [status|install|uninstall|restart|once|run]
                         the per-machine daemon that knows what each agent here is really doing (working, waiting in a
                         wait, idle, down) and tells GitHub on a change plus a keepalive. install keeps it running
                         (autostart install does it too); status shows what it sees

Look
  status [--json]        the whole factory at a glance, across machines: agents, open PRs (CI, reviews, holds),
                         the CI queue and runners, and the tasks; read-only
  prs [--json]           what a manager decides from, one list: each open PR with its head, CI judged by one rule,
                         the newest marker per commit, any review claim and the next action; then unanswered questions
                         and owner asks, and agents gone quiet. Read-only, REST only
  claims                 which agent holds which folder and task
  reviews                which extra reviews and checks the current change needs
  rereview plan|prompt|record|reply
                         incremental re-review: a reviewer's next round reads only the delta since its last one
  manager-claims list|next|review|answer|release|sweep|merge|ask
                         several dev managers at once: claim a PR or a question with a lease (manager.claimMinutes),
                         so two managers never review, answer, merge or ask the same thing twice; list shows who holds what
  lessons [show|check|suggest|add|prune]
                         the short lessons file builders and reviewers read first; suggest proposes new ones from
                         recent must-fix comments, review findings and CI failures (add and prune: dev manager)
  env [name|N]           the ports and database of this folder (or of that agent)
  worktree <name|N>      print that agent's folder (created the first time): cd "$(factory worktree taytu)"
  machine [show|setup N] this machine's id and agent names; setup haile,tewodros writes the names file
  follow [<agent>] [--read|--log] [--on R] [--all]
                         watch and talk to an agent by name, on another machine or in the cloud: without a name,
                         every agent and one-item sub-manager we can find, where it runs and its Remote Control link
  say <agent> "text"     send one message to that agent's session, as if typed (logged on its machine, without the text)
  remote [add|cloud|list|remove]
                         how to reach other machines: add dev-pc factory@192.168.2.45; cloud haile <claude.ai link>
  agents ls [--json] [--local] [--fresh]
                         every agent in one table: kind, where (this machine, another, the cloud), state (working,
                         waiting, idle, down), task, since, last seen and the link to follow it. This machine is read
                         live from the heartbeat daemon; the others from GitHub, cached a short while
  agents [list|card|sweep]
                         live agents (issues mode): who is working, idle or down; list --json and card <name> give the
                         agent cards; sweep marks silent ones down and gives back the issues of agents that are really
                         down (never of one that is alive and waiting)
  messages [ls|new]      questions and answers between agents, the dev manager and the PO: ls [--to X] [--state S]
                         [--ref N] lists what is open across issues and PRs; new --kind question --to po prints the
                         envelope to paste at the top of a comment (docs/messages.md)
  issues [list]          tasks as GitHub issues (tasks.source "issues"): list, show N, stale, setup, new ...

Check
  verify                 run what CI runs (commands.ci) for this commit; a ready PR needs it passed when it's set
  fix                    format and auto-fix the files this branch changed (commands.fix); the Stop check and
                         verify run it first, so style never costs a turn
  run-check <command>    run a check or test quietly: one line if it passes, the first errors (capped) and the
                         full log path if it fails
  check                  the style checks CI runs (one class per file and so on)
  guard                  the Factory guard CI runs, on the current branch
  turbo status           the shared Turborepo build cache (#59): what is set, where the token comes from, and whether it
                         answers. Agents and CI use it when turbo.api and a token are set, and build locally when not
  turbo install [--no-github]
                         start the cache server on this machine (Docker) and give CI the same cache (repo variables
                         and secrets); run it again to update. turbo down [--purge] stops it
  doctor [--sandbox]     check this machine and project (tools, logins, Node, Docker, submodules, secrets setup,
                         agent names) and say how to fix each gap; read-only. --sandbox also checks the sandbox
                         of a bootstrapped machine (no sudo, home network blocked, rootless Docker); run it as that user
  bootstrap machine|project|all|status|uninstall
                         set up a sandboxed factory machine: the dedicated user, rootless Docker, the network guard.
                         `sudo factory bootstrap machine` prints the plan; --apply runs it as root, --script FILE writes it
                         as a bash script to read first. `project` (as that user) ends with doctor --sandbox. Nothing
                         privileged runs unless you pass --apply; sign-ins and the age key stay yours

CI                       local (a self-hosted runner on this machine) or GitHub's runners; names from the project
  ci status              where CI runs, the latest runs on main and open PRs, and the local runner if any
  ci use local|github    send CI jobs to the self-hosted runners (labels <repo>-local and <repo>-light), or back
  ci stale | check       are the installed runner copies older than the checkout / fit to start (update runs both)
  ci install             install ci.runners runners and the light lane as <repo>-ci, -2 ... and -light: LaunchAgents
                         on macOS, systemd --user services on Linux (run it again to update or change the number)
  ci uninstall [i]       remove them (or instance i: 2 ... or light), their containers and idle registrations
  ci start | stop        run one runner by hand, in the background, until stop or a restart
  ci logs [i] [-f]       a runner's log (instance 1 unless you name one)

Settings
  settings               the interactive menu in a terminal (browse by section, search with /, ? for help, change,
                         review the diff, save); in a pipe or script it prints the list. settings interactive: the menu anywhere
  settings list [--section S] [--json]
                         every setting: value, default, overridden or not, and what it does
  settings help [<key>]  the long help for one setting (what reads it, examples, who must approve a change), or the sections
  settings show <key>    one setting in brief: type, default, value here, options
  settings get <key>     just the value, as JSON; dotted keys such as tasks.source
  settings set <key> <v> change one (checked against its type and limits); unset <key> goes back to the default
  settings diff          what the project file sets differently from the defaults
  settings validate      exit 1 with clear messages on a bad value (invalid regex, unknown tasks.source, duplicate agent ...)
  settings pr [--ready]  propose the edited .claude/factory.json as a pull request (a draft by default)
  settings --local ...   the same for this machine's own settings (agent names, Remote Control, autostart), outside the repo
  settings docs [--check|--write]
                         the README's settings tables, generated from the same metadata table
                         .claude/ is protected, so a project change reaches main through a pull request. Agents can't
                         run set, unset, pr, interactive or --local changes.

Measure
  usage [--since D] [--by task|agent|model] [--record LABEL]
                         tokens per task from this machine's Claude Code logs; --record appends a row to the usage log
  report [--since D]     per task, from GitHub: claim to PR to merge, rework rounds and CI runs (failed)

Maintain
  release <agent>        drop an agent's local claims (taytu ...), for example after a crash
  clean                  remove agent worktrees no agent is using (and with no uncommitted work), and local task
                         branches whose task is done
  wait <pr> [minutes]    wait for a pull request to merge, without spending tokens
  wait ci|answer <pr> [minutes], wait slot|ready [minutes]
                         the other token-free waits: CI finished, question answered, a PR slot free, a task ready
  precheck               dev manager: "nothing to do" (exit 0) or one line per thing to do (exit 3), without a model
  watch [--json]         dev manager: the seven checks (unreviewed head, open question, must-fix or red CI or conflict,
                         approved and green, owner waits, agents down or idle, queued CI): one line each and who it is for
                         (manager or owner), exit 3 when any, without a model. The orchestrator starts from this
  prd [--open] [--story N] [--json] | --stage [--ask vision|design|plan]
                         progress against the PRD from GitHub: per user story its tasks (a `PRD: US-3` line in the
                         task) and state, how many stories are done, which have no task. --stage: the flow from an idea to a first milestone and the owner's gates. Plain text, read-only
  signoff ls|add|plan|confirm|result
                         the sign-off and testing queue: what only a person can check, and test plans for the running
                         app (proposed, confirmed by the owner, then results recorded)
  artifacts pull|status|list
                         the project's artifacts and designs as reviewed copies in the repo, with a manifest of where
                         each came from; status says which copy is older than its artifact
  handover snapshot [--json]
                         what a manager hands over, read from GitHub: open PRs, tasks, owner asks, what needs a manager
                         now, agents and numbers in use (the runbook is docs/manager-handover.md)
  manage-tick [--dry-run] precheck, then ONE `claude -p "/manage-pass"` only when there is work: an idle tick makes no model
                         call (run it from cron or a timer)
  version                installed release, the one main pins, the newest, and what changed since
  releases [--all]       the releases that exist, with dates and a one-line note
  update [version]       a project on releases: install the newest (or that) release, check its checksum, refresh this
                         machine's runner services and verify; then commit it in a PR. Safe to repeat. --release: start
                         taking releases in a project that has no pin yet
  rollback               back to the release installed before (needs no network)
  update [--layout new]  a project still on the my-skills submodule (no pin yet): pull the newest my-skills and relink;
                         then commit it in a PR (new: point the links at the factory's own folders instead of kit/)
  install-shim           put a `factory` command on your PATH (~/.local/bin) that works in every factory project
EOF
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  loop)
    # A role word (or FACTORY_ROLE) picks the role. `factory loop -i` alone, in a terminal, asks which (#102); an
    # unattended `factory loop` (no -i, scripts, autostart) stays a coding agent, so nothing running today changes.
    rest=(); want="${FACTORY_ROLE:-}"; asks=0
    for a in "$@"; do
      case "$a" in coding-agent|dev-manager|product-owner) want="$a" ;; -i|--interactive) asks=1; rest+=("$a") ;; *) rest+=("$a") ;; esac
    done
    if [ -z "$want" ] && [ "$asks" = 1 ] && [ -t 0 ] && [ -t 2 ]; then
      pick="$(py factory_roles.py choose)" || exit 1
      read -r want pickname <<< "$pick"
      exec env FACTORY_ROLE="$want" FACTORY_NAME="$pickname" "$root/factory-loop.sh" ${rest[@]+"${rest[@]}"}
    fi
    [ -n "$want" ] && export FACTORY_ROLE="$want"
    exec "$root/factory-loop.sh" ${rest[@]+"${rest[@]}"} ;;
  coding-agent|dev-manager|product-owner)
    role="$cmd"; who=""
    if [ -n "${1:-}" ] && [ "$1" != loop ]; then who="$1"; shift; fi
    [ "${1:-}" = loop ] || { echo "usage: factory $role [name|N] loop [-i] [--once] [--dry-run]" >&2; exit 1; }
    shift
    case "$who" in ''|*[!0-9]*) ;; *) who="$(py factory_roles.py nth "$role" "$who")" || exit 1 ;; esac
    exec env FACTORY_ROLE="$role" FACTORY_NAME="$who" "$root/factory-loop.sh" "$@" ;;
  init)      py factory_init.py "$@" ;;
  init-roles) py factory_roles.py init "$@" ;;
  agent)
    # --detach (#106): start the agent in a detached tmux session, which `factory follow <name>` finds from anywhere.
    detach=0; rest=()
    for a in "$@"; do if [ "$a" = --detach ]; then detach=1; else rest+=("$a"); fi; done
    set -- ${rest[@]+"${rest[@]}"}
    if [ "$detach" = 1 ]; then exec python3 "$hooks/factory_follow.py" detach "$@"; fi
    [ -n "${1:-}" ] || { echo "usage: factory agent <name|N> [claude arguments]: Claude in that agent's folder, for manual work. To run the queue, use factory loop -i (a fresh session per task)." >&2; exit 1; }
    who="$1"; shift
    bare=0; [ "$#" = 0 ] && bare=1
    dir="$(py factory_claims.py worktree "$who")" || exit 1
    name="$(basename "$dir")"; [ "$dir" = "$root" ] && name="$who"
    echo "$name: $dir"
    # One session for many tasks grows with each one (#56): the loop gives every task a fresh context instead.
    [ "$bare" = 1 ] && echo "For manual work in $name's folder. To run the queue, use factory loop -i instead: a fresh session per task."
    cd "$dir" || exit 1
    # A reused worktree may be behind main's submodule pin, and a new one may have none yet: without it the kit's
    # links in .claude/ point at nothing and Claude would start without the hooks and deny rules (#46).
    if [ -f .gitmodules ]; then git submodule update --init -q || { echo "factory: git submodule update failed in $dir" >&2; exit 1; }; fi
    if [ ! -e .claude/settings.json ]; then
      echo "factory: $dir/.claude/settings.json doesn't resolve, so the factory's hooks and deny rules wouldn't load. Run \`git submodule update --init\` there, or \`bash vendor/my-skills/software-factory/install.sh . --link\`, and try again." >&2
      exit 1
    fi
    # Only the project's MCP servers, as main has them on origin (never this worktree's .mcp.json), and never the
    # user's own connectors (#55), as in factory-loop.sh. --mcp-config takes several values, so a flag must follow it.
    mcp="$(python3 "$dir/.claude/hooks/factory_mcp.py")"; [ -n "$mcp" ] || mcp='{"mcpServers":{}}'
    # The `models` setting for the builder (factory_models.py): after the MCP flags, before your own arguments.
    mf=()
    if [ -f "$dir/.claude/hooks/factory_models.py" ]; then
      m="$(python3 "$dir/.claude/hooks/factory_models.py" flags builder 2>&1)" || { echo "$m" >&2; exit 1; }
      while IFS= read -r line; do [ -n "$line" ] && mf+=("$line"); done <<< "$m"
    fi
    set -- --mcp-config "$mcp" --strict-mcp-config --settings '{"disableClaudeAiConnectors": true}' ${mf[@]+"${mf[@]}"} "$@"
    # Remote Control, as in `factory loop -i`: reach this session from claude.ai/code or your phone.
    # FACTORY_REMOTE_CONTROL=0|1 wins; else this machine's `remoteControl` setting (factory settings --local); else on.
    rc="${FACTORY_REMOTE_CONTROL:-}"; [ -n "$rc" ] || rc="$(python3 "$dir/.claude/hooks/factory_machine.py" remote 2>/dev/null || echo 1)"
    if [ "$rc" = 1 ]; then exec claude --remote-control="$name" "$@"; fi
    exec claude "$@" ;;
  worktree)  py factory_claims.py worktree "${1:?usage: factory worktree <name|N>}" ;;
  issues)    py factory_issues.py "${1:-list}" "${@:2}" ;;
  machine)   py factory_machine.py "${1:-show}" "${@:2}" ;;
  follow|say|remote)  py factory_follow.py "$cmd" "$@" ;;
  agents)    py factory_agents.py "${1:-list}" "${@:2}" ;;
  messages)  py factory_messages.py "${1:-ls}" "${@:2}" ;;
  heartbeat) py factory_heartbeat.py "${1:-status}" "${@:2}" ;;
  next)      py next_task.py "$@" ;;
  autostart) py factory_autostart.py "$@" ;;
  resume)    py factory_resume.py "$@" ;;
  status)    py factory_status.py "$@" ;;
  prs)       py factory_prs.py "$@" ;;
  claims)    py factory_claims.py "${1:-list}" "${@:2}" ;;
  release)   py factory_claims.py release --agent "${1:?usage: factory release <agent>}" ;;
  clean)     py factory_claims.py clean ;;
  reviews)   py factory_reviews.py "$@" ;;
  rereview)  py factory_rereview.py "$@" ;;
  manager-claims) py factory_manager_claims.py "$@" ;;
  lessons)   py factory_lessons.py "${1:-show}" "${@:2}" ;;
  settings)  py factory_settings.py "$@" ;;
  usage)     py factory_usage.py "$@" ;;
  report)    py factory_report.py "$@" ;;
  env)       if [ -n "${1:-}" ]; then
               case "$1" in *[!0-9]*) a="$1";; *) a="agent-$1";; esac; py factory_env.py --agent "$a"
             else py factory_env.py; fi ;;
  verify)    py factory_verify.py "$@" ;;
  fix)       py factory_fix.py "$@" ;;
  run-check) py factory_run_check.py "$@" ;;
  check)     py style_checks.py ;;
  guard)     py factory_guard.py --base "origin/$(main)" --branch "$(git branch --show-current)" "$@" ;;
  doctor)    py factory_doctor.py "$@" ;;
  wait)      case "${1:-}" in
               ci|answer|slot|ready) py factory_wait.py "$@" ;;
               *) exec "$hooks/wait_for_merge.sh" "${1:?usage: factory wait <pr> [minutes] | ci|answer <pr> | slot | ready}" "${2:-30}" ;;
             esac ;;
  precheck)  py factory_wait.py precheck ;;
  watch)     py factory_watch.py "$@" ;;
  prd)       py factory_prd.py "$@" ;;
  artifacts) py factory_artifacts.py "$@" ;;
  handover)  py factory_handover.py "$@" ;;
  signoff)   py factory_signoff.py "$@" ;;
  manage-tick) py factory_tick.py "$@" ;;
  turbo)     py factory_turbo.py "$@" ;;
  version|releases|rollback) py factory_release.py "$cmd" "$@" ;;
  update)
    # A project with a release pin (.claude/factory/release.json), or one that asks (a version, --release), takes the
    # factory from numbered releases (#113). Any other project keeps the submodule update below until it migrates.
    if [ -f .claude/factory/release.json ]; then py factory_release.py update "$@"; exit $?; fi
    for a in "$@"; do case "$a" in --release|v[0-9]*|[0-9]*) py factory_release.py update "$@"; exit $? ;; esac; done
    # --layout new|old|auto goes to install.sh: a project that links through kit/ stays on it until it asks for `new`.
    layout=auto
    case "${1:-}" in
      --layout) layout="${2:-}" ;;
      --layout=*) layout="${1#--layout=}" ;;
      "") ;;
      *) echo "factory: unknown option $1 (factory update [--layout new|old|auto])" >&2; exit 1 ;;
    esac
    case "$layout" in new|old|auto) ;; *) echo "factory: --layout takes new, old or auto, not '$layout'" >&2; exit 1 ;; esac
    sub="$(git config -f .gitmodules --get-regexp 'submodule\..*\.url' | awk '/my-skills/ {split($1, a, "."); print a[2]}' | head -1)"
    [ -n "$sub" ] || { echo "factory: no my-skills submodule in .gitmodules" >&2; exit 1; }
    path="$(git config -f .gitmodules --get "submodule.$sub.path")"
    old="$(git -C "$path" rev-parse --short HEAD 2>/dev/null || echo none)"
    git submodule update --init -q "$path" && git submodule update --remote -q "$path" || exit 1
    new="$(git -C "$path" rev-parse --short HEAD)"
    # Same commit: still relink, because the layout may have been asked for (and a re-run changes nothing otherwise).
    if [ "$old" = "$new" ] && [ "$layout" = auto ]; then echo "my-skills is already at $new"; exit 0; fi
    [ "$old" = "$new" ] || { echo "my-skills $old -> $new:"; git -C "$path" log --oneline "$old..$new" 2>/dev/null | sed 's/^/  /'; }
    bash "$path/software-factory/install.sh" . --link --layout "$layout" | grep -E '^(relinked|linked .*was a copy|kept .*differs)' || true
    echo; echo "Now commit it on a branch and open a PR, for example:"
    echo "  git checkout -b chore/update-my-skills && git add -A && git commit -m \"Update my-skills to $new\"" ;;
  install-shim)
    bin="${HOME}/.local/bin"; mkdir -p "$bin"
    cat > "$bin/factory" <<'EOF'
#!/usr/bin/env bash
# Runs the `factory` of the project you're in, so each project uses the factory version it pins.
root="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "factory: run this inside a project's git repo" >&2; exit 1; }
[ -x "$root/factory" ] && exec "$root/factory" "$@"
echo "factory: $root has no ./factory. Install the software factory there first." >&2; exit 1
EOF
    chmod +x "$bin/factory"
    echo "Installed $bin/factory."
    case ":$PATH:" in *":$bin:"*) ;; *) echo "Add it to your PATH, for example in ~/.zshrc:  export PATH=\"\$HOME/.local/bin:\$PATH\"";; esac ;;
  ci)        exec bash "$root/.claude/ci/ci.sh" "$@" ;;
  help|-h|--help) usage ;;
  *) echo "factory: unknown command '$cmd'" >&2; usage >&2; exit 1 ;;
esac
